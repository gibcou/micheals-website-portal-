{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "installCommand": "npm install",
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "rewrites": [
    {
      "source": "/api/:path*",
      "destination": "https://base44.app/api/:path*"
    },
    {
      "source": "/ws-user-apps/:path*",
      "destination": "https://base44.app/ws-user-apps/:path*"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ]
}