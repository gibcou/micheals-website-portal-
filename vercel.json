{
  "framework": "vite",
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "rewrites": [
    { "source": "/clientportal/assets/:path*", "destination": "/assets/:path*" },
    { "source": "/clientportal/favicon.svg", "destination": "/favicon.svg" },
    { "source": "/clientportal/manifest.json", "destination": "/manifest.json" },
    { "source": "/(.*)", "destination": "/index.html" }
  ]
}
