NEXT_PUBLIC_SUPABASE_URL="your-supabase-url"
NEXT_PUBLIC_SUPABASE_ANON_KEY="your-supabase-anon-key"

# Google Identity Services client ID (Google Cloud Console -> APIs &
# Services -> Credentials -> OAuth 2.0 Client ID, Web application type).
# Used for the "Sign in with Google" button on /login -- separate from any
# Google provider configured in Supabase Auth.
NEXT_PUBLIC_GOOGLE_CLIENT_ID=

# Message notification emails (src/app/api/notifications/message/route.js).
# Server-only -- never prefix these with NEXT_PUBLIC_, they must not reach
# the browser bundle.

# Supabase Project Settings -> API -> service_role key. Bypasses Row Level
# Security entirely -- treat this like a root password, never log it or
# expose it to the client.
SUPABASE_SERVICE_ROLE_KEY=

# Resend API key (resend.com -> API Keys). Same key used by the main
# site's onboarding form notification is fine to reuse here.
RESEND_API_KEY=

# Optional. Defaults to Resend's shared test address if unset.
RESEND_FROM_EMAIL=

# Shared secret the Supabase Database Webhook sends as the x-webhook-secret
# header, so this endpoint can tell a real webhook call from anyone else
# hitting the URL. Generate any random string, e.g. `openssl rand -hex 24`.
MESSAGE_WEBHOOK_SECRET=

# Used to build the "reply in the portal" link in notification emails.
# Defaults to the production URL if unset.
NEXT_PUBLIC_SITE_URL=
