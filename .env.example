NEXT_PUBLIC_SUPABASE_URL="your-supabase-url"
NEXT_PUBLIC_SUPABASE_ANON_KEY="your-supabase-anon-key"

# Google Identity Services client ID (Google Cloud Console -> APIs &
# Services -> Credentials -> OAuth 2.0 Client ID, Web application type).
# Used for the "Sign in with Google" button on /login -- separate from any
# Google provider configured in Supabase Auth.
NEXT_PUBLIC_GOOGLE_CLIENT_ID=
