{
  "name": "Invoice",
  "type": "object",
  "properties": {
    "invoice_number": {
      "type": "string",
      "title": "Invoice Number"
    },
    "estate_id": {
      "type": "string",
      "title": "Estate ID"
    },
    "estate_name": {
      "type": "string",
      "title": "Estate Name"
    },
    "client_id": {
      "type": "string",
      "title": "Client User ID"
    },
    "amount": {
      "type": "number",
      "title": "Amount"
    },
    "status": {
      "type": "string",
      "enum": [
        "draft",
        "sent",
        "paid",
        "overdue"
      ],
      "default": "draft",
      "title": "Status"
    },
    "issue_date": {
      "type": "string",
      "format": "date",
      "title": "Issue Date"
    },
    "due_date": {
      "type": "string",
      "format": "date",
      "title": "Due Date"
    },
    "description": {
      "type": "string",
      "title": "Description"
    },
    "paid_date": {
      "type": "string",
      "format": "date",
      "title": "Paid Date"
    },
    "reminder_sent_date": {
      "type": "string",
      "format": "date",
      "title": "Reminder Sent Date"
    }
  },
  "required": [
    "invoice_number",
    "estate_id",
    "client_id",
    "amount"
  ],
  "rls": {
    "read": {
      "$or": [
        {
          "data.client_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "update": {
      "$or": [
        {
          "data.client_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}