{
  "name": "ServiceRequest",
  "type": "object",
  "properties": {
    "title": {
      "type": "string",
      "title": "Title"
    },
    "description": {
      "type": "string",
      "title": "Description"
    },
    "category": {
      "type": "string",
      "enum": [
        "Maintenance",
        "Cleaning",
        "Property",
        "Other"
      ],
      "default": "Maintenance",
      "title": "Category"
    },
    "priority": {
      "type": "string",
      "enum": [
        "low",
        "medium",
        "high",
        "urgent"
      ],
      "default": "medium",
      "title": "Priority"
    },
    "status": {
      "type": "string",
      "enum": [
        "open",
        "in_progress",
        "scheduled",
        "completed",
        "cancelled"
      ],
      "default": "open",
      "title": "Status"
    },
    "estate_id": {
      "type": "string",
      "title": "Estate ID"
    },
    "estate_name": {
      "type": "string",
      "title": "Estate Name"
    },
    "client_id": {
      "type": "string",
      "title": "Client User ID"
    },
    "assigned_to": {
      "type": "string",
      "title": "Assigned To"
    },
    "scheduled_date": {
      "type": "string",
      "format": "date",
      "title": "Scheduled Date"
    },
    "completed_date": {
      "type": "string",
      "format": "date",
      "title": "Completed Date"
    },
    "photo": {
      "type": "string",
      "title": "Photo"
    }
  },
  "required": [
    "title",
    "category",
    "estate_id",
    "client_id"
  ],
  "rls": {
    "read": {
      "$or": [
        {
          "data.client_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "create": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "update": {
      "$or": [
        {
          "data.client_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "data.client_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    }
  }
}